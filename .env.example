# Railway / Production Environment Variables
PORT=8000
DEBUG=False
SECRET_KEY=change-in-production-secure-ripple-secret-key
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=https://your-ui.vercel.app,http://localhost:5173,http://localhost:5175
CSRF_TRUSTED_ORIGINS=https://your-ui.vercel.app

# Optional (GitHub API rate limits / private repos)
GITHUB_TOKEN=

# Optional (If PostgreSQL plugin is added on Railway, Railway sets this automatically):
# DATABASE_URL=postgresql://user:pass@host:5432/railway
